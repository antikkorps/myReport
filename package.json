{
  "name": "myreport",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant SaaS platform for audit firms",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:watch": "turbo run test:watch",
    "test:e2e": "turbo run test:e2e",
    "dev:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "dev:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "dev:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
    "dev:reset": "docker compose --env-file .env -f infra/docker-compose.yml down -v && docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,vue,css}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "turbo": "^2.9.8",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
