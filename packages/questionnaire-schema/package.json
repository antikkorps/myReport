{
  "name": "@myreport/questionnaire-schema",
  "version": "0.0.0",
  "private": true,
  "description": "DSL types and structural validation for questionnaire templates (TypeBox + JSON Schema export for Monaco)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@myreport/shared-schemas": "workspace:*",
    "@sinclair/typebox": "0.34.48"
  },
  "devDependencies": {
    "vitest": "4.1.6"
  }
}
