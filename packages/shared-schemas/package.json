{
  "name": "@myreport/shared-schemas",
  "version": "0.0.0",
  "private": true,
  "description": "Shared API DTOs and validation schemas (TypeBox for the API, Zod for the front)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./primitives": {
      "types": "./src/primitives/index.ts",
      "default": "./src/primitives/index.ts"
    },
    "./envelopes": {
      "types": "./src/envelopes/index.ts",
      "default": "./src/envelopes/index.ts"
    },
    "./dtos": {
      "types": "./src/dtos/index.ts",
      "default": "./src/dtos/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.48",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "vitest": "4.1.6"
  }
}
