{
  "name": "@myreport/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify HTTP API for myReport",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/jwt": "10.0.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/sensible": "6.0.4",
    "@fastify/swagger": "9.7.0",
    "@fastify/swagger-ui": "5.2.4",
    "@fastify/type-provider-typebox": "6.1.0",
    "@myreport/db": "workspace:*",
    "@myreport/email": "workspace:*",
    "@myreport/questionnaire-schema": "workspace:*",
    "@myreport/rbac": "workspace:*",
    "@myreport/shared-schemas": "workspace:*",
    "@sinclair/typebox": "0.34.48",
    "argon2": "0.44.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "fastify-plugin": "5.1.0",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.8",
    "uuidv7": "1.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.14.0",
    "testcontainers": "11.14.0",
    "vitest": "4.1.5"
  }
}
